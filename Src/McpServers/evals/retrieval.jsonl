# Retrieval eval — 카드 검색이 근거를 실제로 찾아오는지 잰다 (RESEARCH_DSN 필요).
# 각 줄: {id, query, must_retrieve, must_have_counterexample?,
#         counterexample_must_include?, counterexample_must_not_include?}
#
# must_retrieve 는 그 질의에 대해 **이견 없이 관련 있는** 카드만 넣는다. 욕심을
# 내면 검색이 나빠져서가 아니라 기대가 과해서 떨어지고, 그러면 지표가 회귀
# 감지에 쓸모없어진다. 카드 ID 는 Game-Design-and-Planning_resarch 의 실물이다.
#
# 반례 쪽 기대는 2026-07-29 에 다시 썼다. 전에는 8개 전부
# must_have_counterexample: true 였는데, 그건 "반례를 잘 찾는다"가 아니라
# **하한선이 없어서 뭐라도 항상 올라온다**를 재고 있었다 (반례 질의는
# kind='GAME' AND type IN ('failure','mixed') 하드 필터다). 임베딩 모드로 실측한
# 뒤로는 두 가지를 나눠 잰다.
#
#   counterexample_must_include      — 사람이 봐서 맞는 반례. 놓치면 회귀.
#   counterexample_must_not_include  — 사람이 봐서 무관한 카드. 올라오면 회귀.
#
# 두 번째가 하한선(RESEARCH_COUNTEREXAMPLE_MIN_SCORE)을 감시한다. 카드가 늘어
# 진짜 반례가 생기면 그 케이스에 must_include 를 옮겨 적는다 — "반례가 없다"를
# 실패로 치지 않으므로, DB 가 자라는 것 자체는 이 검사를 깨뜨리지 않는다.
{"id": "ret-001", "query": "귀여운 동물이 폐허를 탐험하는 도트 그래픽 2D 오픈월드 생존 샌드박스", "must_retrieve": ["GENRE-006"], "counterexample_must_not_include": ["GAME-022"]}
{"id": "ret-002", "query": "덱빌딩으로 시작해 장르 자체를 배신하는 메타 내러티브", "must_retrieve": ["GAME-001"], "counterexample_must_not_include": ["GAME-004"]}
{"id": "ret-003", "query": "지도 마커 없이 랜드마크를 보고 다음 목적지를 정하는 탐험 설계", "must_retrieve": ["ELEM-012"], "counterexample_must_not_include": ["GAME-027"]}
{"id": "ret-004", "query": "같은 시간을 반복하며 정보를 쌓아 나가는 루프 구조 내러티브", "must_retrieve": ["ELEM-004"], "must_have_counterexample": true, "counterexample_must_include": ["GAME-005"]}
{"id": "ret-005", "query": "가챠 확률과 천장 시스템이 과금 신뢰에 미치는 영향", "must_retrieve": ["ELEM-017"], "must_have_counterexample": true, "counterexample_must_include": ["GAME-025"]}
{"id": "ret-006", "query": "죽을 때마다 무작위 업그레이드를 뽑는 로그라이크 진행", "must_retrieve": ["ELEM-018"], "counterexample_must_not_include": ["GAME-004"]}
{"id": "ret-007", "query": "픽셀 아트 스타일을 채택한 2D 게임의 아트 방향", "must_retrieve": ["ELEM-013"], "counterexample_must_not_include": ["GAME-007"]}
{"id": "ret-008", "query": "플레이어를 따라다니며 돕는 동반자 캐릭터 설계", "must_retrieve": ["ELEM-008"], "counterexample_must_not_include": ["GAME-023"]}
# ret-009 ~ ret-013 — 고유명사 질의. 하이브리드 검색(2026-07-29)이 없으면 전부
# 떨어진다. 임베딩은 게임 제목을 의미로 뭉개지만(벡터 단독 순위 8~20위, k=6 밖),
# 트라이그램은 글자를 그대로 맞춘다. 실측: supporting 풀 17개 질의에서
# recall@6 이 벡터 단독 12/17 → 하이브리드 17/17.
# 반례 기대를 달지 않은 것은 이 다섯이 "아이디어"가 아니라 "조회"라서다 —
# 반례 슬롯은 기획 아이디어에 대한 실패 사례를 담는 자리다.
{"id": "ret-009", "query": "Undertale 불살 루트", "must_retrieve": ["GAME-002"]}
{"id": "ret-010", "query": "Genshin Impact 원소 반응", "must_retrieve": ["GAME-024"]}
{"id": "ret-011", "query": "Elden Ring 사망 후 룬 회수", "must_retrieve": ["GAME-016"]}
{"id": "ret-012", "query": "Borderlands 2 무기 드랍 테이블", "must_retrieve": ["GAME-012"]}
{"id": "ret-013", "query": "Breath of the Wild 사당 보상 설계", "must_retrieve": ["GAME-014"]}
# ret-014 ~ ret-017 — 아키텍처 카드(ARCH). 이 카드들은 spec 에 원문이 실려 개발
# AI 까지 가므로(strategic/arch_cards.py), 검색에서 빠지면 지침이 통째로
# 사라진다. 인용은 남고 내용이 없는 상태는 lint S6 가 반려하니 조용히 나빠지는
# 대신 시끄럽게 터지지만, 애초에 잡히는지를 여기서 지킨다.
#
# ARCH 는 지지 근거와 몫이 나뉘어 있고(arch_k), run_evals 가 채점할 때 두 묶음을
# 합친다. 반례 기대를 달지 않은 것은 ret-009~013 과 같은 이유다 — 이 넷은
# "아이디어"가 아니라 "구현 구조 조회"이고, 반례 슬롯은 기획 아이디어에 대한
# 실패 사례를 담는 자리다.
#
# 기대치는 2026-07-30 트라이그램 모드 실측이다(전부 1위, 2위와 2배 이상 차이).
# ARCH-010(로그 규약)은 그 질의에서 ARCH-007 에 밀려 순위가 뒤집혀 제외했다 —
# 기대가 과하면 지표가 회귀 감지에 쓸모없어진다. **임베딩 모드에서는 순위가
# 달라질 수 있으므로** sentence-transformers 를 설치한 뒤 다시 확인할 것.
{"id": "ret-014", "query": "플레이어 주변 청크만 켜고 벗어난 청크는 끄는 로딩 관리자", "must_retrieve": ["ARCH-003"]}
