# CodeGen eval — 생성된 C# 을 정적으로 채점한다 (Unity 불필요).
# 각 줄: {id, spec, namespace?, must_contain?, must_not_contain?, must_compile?,
#         must_declare?, min_types?, forbid_document_names?, forbid_runtime_bootstrap?}
# must_not_contain 은 이 파이프라인이 2D 전용이라는 사실을 지키는 자리다.
#
# 뒤쪽 네 필드는 **구조**를 본다 (06 문서 §3.2 0단계). must_contain 은 단순 부분
# 문자열이라 주석 안에 있어도 통과하므로, 클래스가 문서 번호 이름이거나 책임이
# 안 쪼개진 것을 이 eval 이 놓쳤다. 그래서 선언된 타입을 직접 센다:
#   forbid_document_names     기본 true — Spec001 같은 이름이면 실패
#   must_declare              이 타입들이 실제로 선언돼야 한다
#   min_types                 최소 이만큼으로 나뉘어야 한다 (책임 분리)
#   forbid_runtime_bootstrap  new GameObject + AddComponent 조합 금지
{"id": "cg-001", "spec": "청크 로더: 플레이어 주변 3x3 청크만 활성 상태로 유지하고, 벗어난 청크는 비활성화한다.", "namespace": "Game.Gameplay", "must_contain": ["MonoBehaviour", "Vector2Int"], "must_not_contain": ["Terrain", "NavMeshAgent", "Rigidbody("], "must_compile": true}
{"id": "cg-002", "spec": "상자 상호작용: 플레이어가 상자에 겹친 상태에서 상호작용 입력을 누르면 인벤토리 UI 를 활성화한다.", "namespace": "Game.Gameplay", "must_contain": ["Collider2D", "SerializeField"], "must_not_contain": ["Input.GetKeyDown", "Collider3D"], "must_compile": true}
{"id": "cg-003", "spec": "낮밤 순환: 정해진 주기로 전역 광량을 보간해 낮과 밤을 교대시킨다.", "namespace": "Game.Gameplay", "must_contain": ["MonoBehaviour", "Time.deltaTime"], "must_not_contain": ["RenderSettings.ambientProbe", "Terrain"], "must_compile": true}
{"id": "cg-004", "spec": "8방향 이동: 새 Input System 으로 읽은 입력을 Rigidbody2D 속도에 반영한다.", "namespace": "Game.Gameplay", "must_contain": ["Rigidbody2D", "Vector2"], "must_not_contain": ["Vector3.forward", "CharacterController"], "must_compile": true}
{"id": "cg-005", "spec": "자원 인벤토리: 고철·씨앗·천 세 종류를 종류별 수량으로 쌓고, 수량이 바뀌면 이벤트를 발행한다.", "namespace": "Game.Gameplay", "must_contain": ["Dictionary", "public"], "must_not_contain": ["Terrain", "NavMesh"], "must_compile": true}
{"id": "cg-006", "spec": "동료 추적: 동료가 플레이어를 일정 거리 유지하며 따라오고, 주변 자원 노드를 감지하면 표식을 켠다.", "namespace": "Game.Gameplay", "must_contain": ["Vector2", "SerializeField"], "must_not_contain": ["NavMeshAgent", "Vector3.Distance"], "must_compile": true}
{"id": "cg-007", "spec": "이 기능의 식별자는 spec-007 이다. 적 스포너: 스폰 지점 목록에서 일정 간격으로 적을 생성하고, 동시 생존 수를 상한으로 제한한다.", "namespace": "Game.Gameplay", "must_contain": ["SerializeField", "MonoBehaviour"], "must_not_contain": ["NavMeshAgent", "Vector3.forward"], "must_compile": true, "forbid_document_names": true}
