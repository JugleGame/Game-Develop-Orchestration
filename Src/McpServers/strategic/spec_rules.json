{
  "_readme": [
    "Single source of truth for spec validation.",
    "Card IDs are unanchored; callers add word or string boundaries.",
    "Rules accept Korean and English spec text, while research cards are English.",
    "English words use whole-word matching; Korean stems use substring matching."
  ],
  "version": 4,
  "cardIdPattern": "(?:ELEM|GENRE|GAME|ARCH)-\\d{3}",
  "requiredKeys": [
    "spec_id",
    "version",
    "blueprint_version",
    "refs"
  ],
  "requiredSections": [
    "Goal",
    "Implementation scope",
    "Out of scope",
    "Acceptance criteria"
  ],
  "bannedWords": [
    "재미",
    "좋은",
    "좋아",
    "멋진",
    "자연스러",
    "적절",
    "재치",
    "fun",
    "nice",
    "nicely",
    "good",
    "cool",
    "great",
    "awesome",
    "natural",
    "naturally",
    "appropriate",
    "appropriately",
    "proper",
    "properly",
    "clever",
    "witty"
  ],
  "observableWords": [
    "로그",
    "콘솔",
    "테스트",
    "씬",
    "파일",
    "커밋",
    "초",
    "개",
    "프레임",
    "%",
    "log",
    "console",
    "test",
    "scene",
    "file",
    "commit",
    "sec",
    "second",
    "seconds",
    "frame"
  ],
  "_measurableGuardsNote": [
    "trigger 는 정규식이다. '초' 를 그냥 부분 문자열로 두면 '초과 획득' 같은",
    "말에 걸린다 — 실제로 첫 구현에서 오탐이 났다. 숫자를 동반한 시간·비율만",
    "잡도록 수량 형태로 못 박는다."
  ],
  "measurableGuards": [
    {
      "trigger": [
        "\\d+(?:\\.\\d+)?\\s*초",
        "\\d+(?:\\.\\d+)?\\s*%",
        "확률",
        "\\d+\\s*ms",
        "밀리초",
        "\\d+(?:\\.\\d+)?\\s*(?:s|sec|secs|second|seconds)\\b",
        "\\bprobability\\b",
        "\\bchance\\b",
        "\\bmillisecond(?:s)?\\b"
      ],
      "require": ["테스트", "test"],
      "reason": "시간·확률은 QA 의 4가지 수단(콘솔/자동테스트/씬검사/로그) 중 자동 테스트로만 잴 수 있다. 테스트 이름을 함께 적지 않으면 QA 는 BLOCKED 로 넘긴다."
    },
    {
      "trigger": ["콘솔에?\\s*(?:.{0,4})?로그", "\\bconsole\\b.{0,20}\\blog\\b"],
      "require": ["에러", "경고", "예외", "error", "warning", "exception"],
      "reason": "QA 가 콘솔에서 읽는 것은 에러·경고뿐이다. 일반 정보 로그는 판정 근거가 못 되므로 Logs/ 파일 로그로 옮긴다 (ARCH-010)."
    }
  ],
  "contaminationGuards": [
    {
      "id": "chunk-streaming",
      "keywords": ["청크", "Chunk"],
      "requiresRef": ["ARCH-002", "ARCH-003"],
      "reason": "청크 스트리밍을 쓰지 않는 게임에 씬 분할 조항이 딸려 들어왔다."
    },
    {
      "id": "commentator",
      "keywords": ["commentator", "해설자"],
      "requiresRef": ["ARCH-007"],
      "reason": "해설자 시스템이 없는 게임에 해설 로그 검사가 딸려 들어왔다."
    },
    {
      "id": "npc-dialogue",
      "keywords": ["NPC", "대화"],
      "requiresRef": ["ARCH-005", "ARCH-006"],
      "reason": "대화 NPC 가 없는 게임에 상태머신·상호작용 조항이 딸려 들어왔다."
    }
  ]
}
