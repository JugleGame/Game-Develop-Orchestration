# bootstrap.py copies this file to the local .env. Never commit real secrets.

# Research MCP: required for the Neon/Postgres card mirror.
RESEARCH_DSN=
STRATEGIC_POOL_MAX=5
STRATEGIC_DB_TCP_TIMEOUT_SECONDS=8
RESEARCH_EMBEDDING_MODEL=BAAI/bge-m3
RESEARCH_COUNTEREXAMPLE_MIN_SCORE=0.45
RESEARCH_ARCH_LIMIT=12

# Unity MCP: required when applying files in the Editor or running builds.
UNITY_PROJECT_PATH=
# Optional: target a specific running Unity Editor when the same project is open more than once.
UNITY_EDITOR_PID=
UNITY_SCRIPT_NAMESPACE=Game.Gameplay
UNITY_SCRIPT_ROOT=Assets/Scripts
UNITY_SCENE_ROOT=Assets/Scenes
UNITY_PREFAB_ROOT=Assets/Prefabs
UNITY_IMPORT_SUBDIR=Generated
UNITY_ASSEMBLY_TIMEOUT=300
UNITY_BUILD_TARGET=WebGL
UNITY_BUILD_TIMEOUT=1800
UNITY_BUILD_OUTPUT=
UNITY_PLAYMODE_SECONDS=10
UNITY_RELAY_PATH=
UNITY_CSHARP_DOTNET_CHECK=1

# Asset MCP: PixelLab generation requires an API key.
PIXELLAB_API_KEY=
ASSET_ROOT=./var/assets
HANDOFF_ROOT=./var/handoffs
ASSET_ART_STYLE=pixel art
ASSET_DEFAULT_GAME_ID=default

LOG_LEVEL=INFO
