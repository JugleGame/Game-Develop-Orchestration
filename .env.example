# Game-Developer-AI — 환경 설정 한 장.
#
#   cp .env.example .env      (또는 python scripts/bootstrap.py 가 대신 만든다)
#
# 이 파일 하나가 저장소 전체의 설정이다. 오케스트레이터(Src/DeveloperAI)는
# app/config/settings.py 가, MCP 서버 다섯 대는 common/env.py 가 이 파일을 읽는다.
# 쉘에 이미 export 된 값이 항상 이긴다 — .env 는 비어 있는 변수만 채운다.
#
# 아래 값은 전부 코드의 기본값과 같다. 그대로 두면 로컬 기본 동작이고,
# [필수] 표시된 것만 실제로 채워야 그 기능이 켜진다. 커밋 금지(.gitignore).

# ─────────────────────────────────────────────────────────────
# 1. 자격증명 — 이 파일에서 유일하게 반드시 손대는 구역
# ─────────────────────────────────────────────────────────────

# [경로 A 필수] LLM 호출용. 경로 B(Claude Code)는 비워 둔다 — 완성된 산출물을
# 인자로 넘기므로 키가 필요 없다. CLAUDE.md "두 가지 실행 경로" 참고.
ANTHROPIC_API_KEY=

# [strategic 필수] 리서치 카드 + spec 저장소(Neon/Postgres). 비면 strategic
# 서버는 기동 직후 종료한다. NEON_DSN 도 같은 뜻으로 읽힌다.
RESEARCH_DSN=

# ─────────────────────────────────────────────────────────────
# 2. 이 머신의 경로
# ─────────────────────────────────────────────────────────────

# Unity 프로젝트 루트. unity 서버의 스크립트 투입·빌드·플레이모드가 여기를 쓴다.
# 비어 있으면 unity 서버는 뜨지만 실제 작업 도구가 실패한다.
UNITY_PROJECT_PATH=

# git 서버가 만드는 bare 저장소 + 작업 클론 루트.
GIT_ROOT=./git_output

# git_commit 의 sourcePath 인자가 없을 때 배포할 Unity 프로젝트 경로.
# 둘 다 없으면 빈 커밋이 된다.
GIT_SOURCE_PATH=

# asset 서버 산출물 루트.
ASSET_ROOT=./asset_output

# Windows 가 아닌 머신에서만: .mcp.json 이 쓸 venv 파이썬.
#   GDAI_PYTHON=../DeveloperAI/.venv/bin/python
# (경로는 Src/McpServers 기준 상대경로다. .mcp.json 의 cwd 가 거기다.)
# 이 값은 Claude Code 가 .mcp.json 을 읽을 때 필요하므로 .env 가 아니라
# 쉘에서 export 해야 한다 — Claude Code 는 .env 를 읽지 않는다.
# GDAI_PYTHON=

# ─────────────────────────────────────────────────────────────
# 3. 오케스트레이터 (Src/DeveloperAI) — 기본값 그대로 동작한다
# ─────────────────────────────────────────────────────────────

DATABASE_URL=postgresql+asyncpg://developer_ai:developer_ai@localhost:5432/developer_ai
REDIS_URL=redis://localhost:6379/0

# MCP Streamable HTTP 엔드포인트. 포트는 Src/McpServers/common/registry.py 와
# 같아야 한다 (tests/test_server_registry.py 가 대조한다).
STRATEGIC_MCP_URL=http://localhost:9101/mcp
UNITY_MCP_URL=http://localhost:9102/mcp
QA_MCP_URL=http://localhost:9103/mcp
ASSET_MCP_URL=http://localhost:9104/mcp
GIT_MCP_URL=http://localhost:9105/mcp

STRATEGIC_MCP_TIMEOUT_SECONDS=120
UNITY_MCP_TIMEOUT_SECONDS=300
QA_MCP_TIMEOUT_SECONDS=180
ASSET_MCP_TIMEOUT_SECONDS=180
GIT_MCP_TIMEOUT_SECONDS=60
MCP_MAX_RETRIES=3

# 재시도 루프 상한. 초과하면 HumanEscalation.
DEVELOPMENT_QA_MAX_ITERATIONS=5
PLANNING_MAX_ITERATIONS=5
CONCEPT_MAX_ITERATIONS=3

# Unity Editor 가 한 번에 한 작업만 받으므로 1 을 유지한다 (§7.1).
MAX_CONCURRENT_JOBS=1

# 모든 API 요청의 X-API-Key 값. 비우면 인증 비활성 — 로컬 전용.
# Src/Web/.env 의 VITE_API_KEY 와 같은 값이어야 한다.
API_KEY=
RATE_LIMIT_CREATE_PER_MINUTE=10
CORS_ALLOW_ORIGINS=["http://localhost:5173"]

LOG_LEVEL=INFO
# 설정하면 JSON 로그를 stdout 과 함께 이 파일에도 남긴다.
LOG_FILE=
LOG_FILE_MAX_BYTES=10000000
LOG_FILE_BACKUP_COUNT=3

# ─────────────────────────────────────────────────────────────
# 4. MCP 서버 — 기본값 그대로 동작한다
# ─────────────────────────────────────────────────────────────

# 바인딩. 서버별 포트는 MCP_PORT_STRATEGIC / _UNITY / _QA / _ASSET / _GIT 로
# 각각 덮어쓴다. MCP_PORT 하나로는 다섯 대를 표현할 수 없다.
MCP_HOST=127.0.0.1
MCP_TRANSPORT=streamable-http

# 모델. 단가가 app/utils/usage.py 에 있어야 비용이 집계된다.
STRATEGIC_MODEL=claude-opus-5
UNITY_CODEGEN_MODEL=claude-opus-5
# 설계 패스(design_architecture). 게임당 한 번만 돌지만 그 한 번이 이후 모든
# 파일의 구조를 정하므로 코드 생성과 같은 급을 기본으로 둔다.
UNITY_DESIGN_MODEL=claude-opus-5
QA_MODEL=claude-sonnet-5

# QA 판정 예산. §03 의 QA 타임아웃 180초보다 작아야 한다.
QA_LLM_TIMEOUT_SECONDS=150
QA_LLM_MAX_TOKENS=4096

# strategic
STRATEGIC_POOL_MAX=5
# TCP 5432 연결 시도의 상한. 넘으면 Neon SQL-over-HTTP(443) 폴백으로 전환한다
# (strategic/neon_http.py) — 사내망이 5432 를 막고 443 만 여는 환경 대응.
STRATEGIC_DB_TCP_TIMEOUT_SECONDS=8
RESEARCH_EMBEDDING_MODEL=jhgan/ko-sroberta-multitask
# 반례로 인정할 최소 코사인 유사도. 반례 질의는 실패/혼재 카드에 대한 하드
# 필터라, 하한선이 없으면 그 풀이 작을 때 무관한 카드가 무조건 올라온다.
# 미달이면 반례를 비우고 "반례 조사 부족"이라고 밝힌다. 임베딩 검색일 때만
# 적용된다 — 트라이그램 폴백은 점수 척도가 달라 이 값을 쓸 수 없다.
# 0.45 의 근거는 06_3-4군_인수인계.md §2.3 의 실측표.
RESEARCH_COUNTEREXAMPLE_MIN_SCORE=0.45
# 아키텍처 지침(ARCH 카드)을 spec 에 실을 때 인용하는 카드 최대 개수.
RESEARCH_ARCH_LIMIT=12

# unity
UNITY_SCRIPT_NAMESPACE=Game.Gameplay
UNITY_SCRIPT_ROOT=Assets/Scripts
UNITY_SCENE_ROOT=Assets/Scenes
UNITY_PREFAB_ROOT=Assets/Prefabs
UNITY_IMPORT_SUBDIR=Generated
# 조립 3종(create_prefab / compose_scene / bind_reference)의 제한 시간(초).
# 빌드와 달리 씬 하나를 만드는 작업이라 짧다. 스크립트가 방금 추가돼 Unity 가
# 재컴파일 중이면 그 시간이 여기 포함되므로 너무 낮추지 않는다.
UNITY_ASSEMBLY_TIMEOUT=300
UNITY_BUILD_TARGET=StandaloneWindows64
UNITY_BUILD_TIMEOUT=1800
UNITY_PLAYMODE_SECONDS=10
# 빌드 산출 경로. 비우면 Builds/<gameId>/game.exe.
UNITY_BUILD_OUTPUT=
# Unity Editor 릴레이 파일 경로 재지정. 보통 건드릴 일이 없다.
UNITY_RELAY_PATH=
# 생성된 C# 을 Unity 에 넣기 전에 `dotnet build` 로도 검사할지. 1(기본)이어도
# dotnet 이 PATH 에 없으면 구조 검사만 하고 조용히 넘어간다. 0 이면 아예 끈다.
UNITY_CSHARP_DOTNET_CHECK=1

# asset
ASSET_ART_STYLE=pixel art
ASSET_DEFAULT_GAME_ID=default

# PixelLab 픽셀아트 생성 API 키(https://pixellab.ai 콘솔에서 발급). 비어 있으면
# 에셋 생성 도구가 전부 에러를 반환한다 — 폴백 경로는 없다.
# 12_PixelLab_에셋생성_연동_구현계획.md §4/§6 참고.
PIXELLAB_API_KEY=
