{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "pytest: current MCP test",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${file}", "-v"],
      "cwd": "${workspaceFolder}/Src/McpServers",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "env": { "PYTHONPATH": "." },
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ]
}
