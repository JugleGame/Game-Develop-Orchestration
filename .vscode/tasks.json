{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "pytest: MCP boundaries",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["-m", "pytest", "Src/McpServers/tests"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": { "PYTHONPATH": "${workspaceFolder}/Src/McpServers" }
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "MCP: verify contract",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["Src/McpServers/verify_contract.py"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "problemMatcher": []
    }
  ]
}
