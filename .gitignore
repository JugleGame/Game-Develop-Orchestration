# 저장소 전역 ignore 규칙

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
*.egg-info/

# 로컬 설정과 자격증명
.env
.env.*
!.env.example
.mcp.json
.mcp.json.bak
.claude/settings.local.json
*.pem
*.key
*.pfx

# 재생성 가능한 런타임 산출물
/var/
**/var/
/asset_output/
/Games/
logs/
*.log

# 편집기
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp

# 운영체제
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
